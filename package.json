{
  "name": "fin-port",
  "version": "0.2.0",
  "private": true,
  "description": "Next.js financial watch dashboard with portfolio tracking and drawdown alerts, on a self-hosted Postgres.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:debug": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:from-supabase": "tsx scripts/migrate-from-supabase.ts",
    "db:seed": "tsx scripts/import.ts seed",
    "db:cash-book": "tsx scripts/import.ts cash-book",
    "db:import": "tsx scripts/import.ts all",
    "db:verify": "tsx scripts/verify-parse.ts",
    "check:analytics": "tsx scripts/check-analytics.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "lightweight-charts": "5.2.0",
    "next": "16.2.6",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.3.0",
    "tsx": "^4.23.13",
    "typescript": "latest"
  }
}
