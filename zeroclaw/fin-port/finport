#!/bin/sh
# fin-port API client for the ZeroClaw skill.
#
#   finport GET    /api/portfolio/summary
#   finport POST   /api/portfolio/transactions '{"symbol":"NVDA","side":"buy",...}'
#   finport PATCH  '/api/portfolio/transactions?id=<id>' '{"price":120}'
#   finport DELETE '/api/portfolio/transactions?id=<id>'
#
# The URL and the passphrase come from a file, not the environment: ZeroClaw's
# shell tool clears the environment and never passes *_TOKEN variables through.
#
#   ~/.config/fin-port/env   (chmod 600)
#     FIN_PORT_URL=http://localhost:3000
#     FIN_PORT_TOKEN=<ADMIN_TOKEN of the fin-port deployment>
#
# Prints the JSON response. Exits 1 on an HTTP error, with the body on stdout
# so the agent can read the {"error": ...} message.

set -eu

# The environment wins (the ZeroClaw daemon hands FIN_PORT_* to the shell
# through shell_env_passthrough); the file is the fallback for a terminal.
if [ -z "${FIN_PORT_TOKEN:-}" ]; then
  CONFIG="${FIN_PORT_CONFIG:-${HOME:-/root}/.config/fin-port/env}"
  [ -r "$CONFIG" ] || { echo "{\"error\":\"FIN_PORT_TOKEN is not set and $CONFIG is not readable\"}"; exit 2; }
  FIN_PORT_URL=${FIN_PORT_URL:-$(sed -n 's/^FIN_PORT_URL=//p' "$CONFIG" | tail -1)}
  FIN_PORT_TOKEN=$(sed -n 's/^FIN_PORT_TOKEN=//p' "$CONFIG" | tail -1)
fi
[ -n "$FIN_PORT_TOKEN" ] || { echo '{"error":"FIN_PORT_TOKEN is empty"}'; exit 2; }
FIN_PORT_URL="${FIN_PORT_URL:-http://localhost:3000}"

[ $# -ge 2 ] || { echo 'usage: finport METHOD /api/path [json-body]' >&2; exit 2; }
METHOD=$(echo "$1" | tr '[:lower:]' '[:upper:]')
PATH_PART=$2
BODY=${3:-}

case "$PATH_PART" in
  /api/*) ;;
  *) echo '{"error":"path must start with /api/"}'; exit 2 ;;
esac

# The token goes to curl through a header file, so it never shows in `ps`.
HEADERS=$(mktemp)
trap 'rm -f "$HEADERS"' EXIT
chmod 600 "$HEADERS"
printf 'Authorization: Bearer %s\n' "$FIN_PORT_TOKEN" > "$HEADERS"

if [ -n "$BODY" ]; then
  RESPONSE=$(curl -sS --max-time 60 -X "$METHOD" -H @"$HEADERS" -H 'Content-Type: application/json' \
    --data-raw "$BODY" -w '\n%{http_code}' "$FIN_PORT_URL$PATH_PART")
else
  RESPONSE=$(curl -sS --max-time 60 -X "$METHOD" -H @"$HEADERS" -w '\n%{http_code}' "$FIN_PORT_URL$PATH_PART")
fi

STATUS=$(printf '%s' "$RESPONSE" | tail -n 1)
printf '%s\n' "$RESPONSE" | sed '$d'
case "$STATUS" in
  2*) exit 0 ;;
  *) echo "HTTP $STATUS" >&2; exit 1 ;;
esac
