# ---------------------------------------------------------------------------
# Supabase — SERVER ONLY. No NEXT_PUBLIC_* prefix anywhere on purpose:
# anything named NEXT_PUBLIC_* is inlined into the browser bundle and shipped
# to every visitor. Every Supabase call in this app runs on the server.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co

# Publishable key (sb_publishable_...). Low privilege, respects RLS.
# Used for reads. Safe-ish to leak, but we still keep it server-side.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key (sb_secret_...). Bypasses RLS. NEVER expose to the browser.
# Supabase dashboard -> Project Settings -> API Keys -> Secret keys.
# Required for imports and any write.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Shared secret guarding every write/import endpoint. Generate with:
#   openssl rand -hex 32
ADMIN_TOKEN=
