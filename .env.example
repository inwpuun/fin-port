# ---------------------------------------------------------------------------
# Copy to .env and fill in. Docker Compose reads THIS file (.env) for the
# POSTGRES_* values it interpolates into docker-compose.yml, and hands the
# whole file to the app container. Next.js and the CLI scripts read it too.
#
# .env.local still wins over .env wherever both set the same name, so keep
# personal overrides there. Compose does not read .env.local.
#
# Nothing here is named NEXT_PUBLIC_*, on purpose: Next.js inlines any
# NEXT_PUBLIC_ value into the browser bundle and ships it to every visitor.
# DATABASE_URL contains a password. It stays on the server.
# ---------------------------------------------------------------------------

# --- Postgres (the `db` service in docker-compose.yml) ---------------------
POSTGRES_USER=finport
POSTGRES_DB=finport

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Host port for the published database. Change it if 5432 is already taken by
# a Postgres you run for something else.
POSTGRES_PORT=5432

# How the app connects.
#
#   host (npm run dev, npm run db:migrate, psql):  @localhost:5432
#   inside Docker Compose:                         @db:5432
#
# Compose overrides this variable for the app container with the `db` host, so
# the value below is the one your own machine uses. Keep the password in sync
# with POSTGRES_PASSWORD above.
DATABASE_URL=postgres://finport:CHANGE_ME@localhost:5432/finport

# --- App -------------------------------------------------------------------
# Shared secret guarding the unlock page and every write/import endpoint.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Bank of Thailand developer portal, for the USD/THB reference rate.
BOT_API_KEY=

# --- Supabase: only for the one-time data migration ------------------------
# Needed solely by `npm run db:from-supabase`, which copies the old hosted
# tables into the Postgres above. Delete both lines once it has run.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxx
